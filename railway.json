{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "uvicorn core.app:app --host 0.0.0.0 --port $PORT --ws-max-size 8192 --ws-max-queue 32 --ws-ping-interval 20 --ws-ping-timeout 20",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
