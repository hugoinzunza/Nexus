# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Configuración local con datos sensibles (claves de API, tokens, etc.)
config/local.json
*.local.json
.env
*.env
!*.env.example
deploy/collector.env

# Sistema operativo
.DS_Store

# Logs
*.log
logs/

# Datos en runtime (sensibles / efímeros): NO se versionan.
#   journal_income.json, push_subs.json, setups.json, vix_1d.json, etc.
# Pero la HISTORIA de velas (klines_*.json) SÍ se versiona: Railway está
# geo-bloqueado de Binance (HTTP 451), así que la única forma de que producción
# tenga años de estructura para los POIs profundos es traerla en el deploy.
data/*
!data/klines_*.json

# Worktrees temporales de agentes Claude
.claude/worktrees/

# Volcado por-trade del estudio de fuerza relativa: 3 MB regenerables con el script
# a partir de data/setup_backtest_trades.json. El JSON de resultados (925 KB) SÍ se
# versiona porque es lo que los tests verifican y lo que sostiene el informe.
research/relative_strength_oos_trades.json

# BTA research: el zip es regenerable (bta_package_zip.py) y los os_screenshots son
# capturas de debug de la automatizacion (no evidencia de charts) — no van al repo.
research/bta_review_package_*.zip
research/tradingview_bta_night_2026-06-30/os_screenshots/
