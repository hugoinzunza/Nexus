# NexUX — variables de entorno (plantilla). NO commitear el .env real.
# Copia las que correspondan según DÓNDE corre cada cosa:
#   - WEB  = Railway (sirve nexux.cl). Tiene DATABASE_URL.
#   - MOTOR = VPS (colector + poller). NO tiene DATABASE_URL (usa stores JSON).
# El sitio funciona "inerte" (un usuario, todo abierto) si no defines auth.

# ====================== WEB (Railway) ======================
# Base de datos (Railway la inyecta sola al referenciar el servicio Postgres):
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Auth (Google OAuth2). Sin estas 3, la auth queda INERTE (sin login).
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
SESSION_SECRET=cadena-larga-aleatoria-para-firmar-cookies
# Opcional: forzar el redirect URI (si no, se deriva del host).
# OAUTH_REDIRECT_URI=https://nexux.cl/auth/callback

# Bóveda (Fase B): SOLO la clave PÚBLICA va en la web (cifra; nunca descifra).
NEXUX_KEK_PUBLIC="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Token compartido con el colector del VPS para la ingesta (mismo valor en ambos).
NEXUS_INGEST_TOKEN=token-compartido-largo-aleatorio

# Web push (alertas SMC), opcional:
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:hugoinzunza@gmail.com

# PORT lo setea Railway automáticamente.

# ====================== MOTOR (VPS) ======================
# Credenciales Binance de SOLO LECTURA (cuenta de Hugo; multi-usuario va por la bóveda).
BINANCE_API_KEY=xxxx
BINANCE_API_SECRET=xxxx

# Bóveda: la clave PRIVADA vive SOLO en el VPS. Por env o por archivo
# (~/.nexus/kek_private.pem, chmod 600). Si está el archivo, no hace falta el env.
# NEXUX_KEK_PRIVATE="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# A dónde ingiere el colector (la app web en Railway) y con qué token:
NEXUS_INGEST_URL=https://<tu-app>.up.railway.app/m/journal/api/ingest
NEXUS_INGEST_TOKEN=token-compartido-largo-aleatorio   # MISMO que en la web

# App local del motor (para chequear salud del poller). Default ya correcto:
# NEXUS_LOCAL_APP=http://localhost:8800
# Cuántos días de historial de Binance leer (default 365):
# BINANCE_LOOKBACK_DAYS=365
# Ruta alternativa del archivo de credenciales del colector:
# NEXUS_COLLECTOR_ENV=/home/hugo/.nexus/binance.env

# Graduador sombra de Claude (opcional; solo si lo quieres activo en el motor):
# ANTHROPIC_API_KEY=sk-ant-...

# Acciones Chile: token de ingesta para una exportación PERSONAL de Renta 4.
# La ingesta también debe habilitarse explícitamente en config/nexus.json.
# NEXUX_CHILE_INGEST_TOKEN=token-distinto-largo-aleatorio
# ANTHROPIC_API_KEY también habilita la auditoría MANUAL de Claude/Opus; nunca
# se llama automáticamente ni se envía la cartera sin una acción explícita.
