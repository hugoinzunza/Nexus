{
  "schema_version": 1,
  "hypothesis_id": "HYP-COST-002",
  "title": "Viabilidad operacional de stops mas estrechos",
  "frozen": true,
  "research_only": true,
  "notice": "Research only - No signal - No bot",
  "seed": 20260802,
  "dataset": {
    "classification": "recycled_causal_research_export",
    "setup_export": "data/setup_backtest_trades.json",
    "candle_pattern": "data/klines_{pair}_{timeframe}.json",
    "pairs": ["BTCUSDT", "ETHUSDT", "SOLUSDT", "ADAUSDT", "XRPUSDT"],
    "timeframes": ["1h", "4h"],
    "required_export_version": "setup-backtest-research-v3"
  },
  "design": {
    "paired_on": "setup_id",
    "stop_multipliers": [1.0, 0.75, 0.5, 0.35],
    "baseline_multiplier": 1.0,
    "target_policy": "original_fixed_price",
    "primary_cost_scenario": "base",
    "sensitivity_cost_scenarios": ["hard", "extreme"],
    "primary_universe": "all_activated",
    "policy_aligned_diagnostic": "original_rr_gte_5",
    "selection_rule": "no_multiplier_selection",
    "estimands": [
      "net_r_per_fixed_risk_unit",
      "net_return_per_entry_notional",
      "exit_transition_contribution",
      "capacity_constrained_portfolio"
    ]
  },
  "costs": {
    "source": "reuse_HYP_COST_001_scenarios",
    "observed_costs_required_for_production_claim": true,
    "declared_scenarios_are_not_realized_costs": true
  },
  "portfolio": {
    "starting_equity_usd": 100000.0,
    "sizing_modes": ["fixed_dollar", "fixed_fraction_current_equity"],
    "primary_sizing_mode": "fixed_dollar",
    "fixed_stop_loss_budget_usd": 1000.0,
    "desired_stop_loss_fraction_of_equity": 0.01,
    "cost_inclusive_stop_sizing": true,
    "max_account_heat_fraction": 0.05,
    "max_single_trade_notional_multiple": 1.5,
    "gross_notional_cap_multiples": [1.0, 3.0, 5.0],
    "primary_gross_notional_cap_multiple": 3.0,
    "allocation_policy": "all_or_nothing",
    "close_before_open_at_same_timestamp": true,
    "opening_tie_break": "setup_id_ascending",
    "mark_to_market_between_closes": false
  },
  "statistics": {
    "primary_estimand": "paired_difference_in_net_return_per_entry_notional",
    "bootstrap_unit": "calendar_month",
    "bootstrap_iterations": 5000,
    "multiple_testing": "holm",
    "primary_family": ["base:0.75_vs_1", "base:0.5_vs_1", "base:0.35_vs_1"],
    "alpha": 0.05,
    "portfolio_results_are_descriptive": true,
    "same_dataset_reuse_makes_all_results_exploratory": true
  },
  "limitations": {
    "historical_exchange_filters_modeled": false,
    "historical_leverage_brackets_modeled": false,
    "liquidation_and_margin_mode_modeled": false,
    "intrabar_mark_to_market_modeled": false,
    "cross_pair_dependence_eliminated": false
  },
  "governance": {
    "automatic_winner_selection": false,
    "automatic_promotion": false,
    "execution_enabled": false,
    "bot_changes_allowed": false,
    "testnet_changes_allowed": false,
    "live_changes_allowed": false
  }
}
